# Bodegol — Apache (Hostinger): seguridad + SPA fallback + caché
# ⚠️ Ninguna protección frontend es 100% segura; estas cabeceras endurecen el sitio
#    pero el contenido público siempre puede capturarse. Ver SECURITY.md.

# 2) Deshabilitar listado de directorios
Options -Indexes

# 3) Proteger archivos sensibles (no afecta a webmanifest/xml/txt del sitio)
<FilesMatch "(^\.|\.(env|env\..*|ini|log|sh|bak|bmp|md|yml|yaml|lock)$)">
  Require all denied
</FilesMatch>

# 1) SPA fallback (rutas /privacidad, /terminos, /404)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# 4) Cabeceras de seguridad básicas
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Content-Security-Policy: ver SECURITY.md. Habilitar tras probar fuentes/mapa embed.
  # Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline'; frame-src https://www.google.com https://maps.google.com; connect-src 'self'"
</IfModule>

# 5) Caché: assets con hash inmutables; HTML/config siempre fresco
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|webp|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|webmanifest|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
