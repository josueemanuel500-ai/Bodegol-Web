# Bodegol — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Business ──────────────────────────────────────────────────────────────
VITE_BUSINESS_ID=bodegol

# ── WhatsApp ──────────────────────────────────────────────────────────────
# Country code + number, no + sign (e.g. Mexico: 52 + 10 digit number)
VITE_WHATSAPP_NUMBER=529991234567

# ── API (future) ─────────────────────────────────────────────────────────
# Uncomment when backend is ready
# VITE_API_URL=https://api.bodegol.com.mx

# ── Supabase (future) ─────────────────────────────────────────────────────
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Analytics (future) ────────────────────────────────────────────────────
# VITE_GA_ID=G-XXXXXXXXXX
# VITE_FB_PIXEL_ID=XXXXXXXXXX
