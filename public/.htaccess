# Bodegol — Apache (Hostinger) config: SPA fallback + light caching
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Do not rewrite real files/directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Everything else → index.html (client-side routing)
  RewriteRule ^ index.html [L]
</IfModule>

# Cache hashed assets aggressively; HTML always fresh
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|webp|jpg|jpeg|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|webmanifest|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
