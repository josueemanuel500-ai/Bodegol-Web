# Bodegol — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Business ──────────────────────────────────────────────────────────────
VITE_BUSINESS_ID=bodegol

# ── WhatsApp ──────────────────────────────────────────────────────────────
# Country code + number, no + sign (e.g. Mexico: 52 + 10 digit number)
VITE_WHATSAPP_NUMBER=529991234567

# ── API (Raven POS backend) ──────────────────────────────────────────────
# Must include /v1 (NestJS's global prefix) — reservation.service.js posts
# to `${VITE_API_URL}/public/${VITE_BUSINESS_ID}/reservations`.
VITE_API_URL=https://api.bodegol.com.mx/v1
# The real Business.id (UUID) from Raven POS — NOT the "bodegol" slug
# default below, the public reservations endpoint looks it up by this
# exact value. Get it from the server:
#   docker compose exec postgres psql -U raven_app -d raven -c "SELECT id, business_name FROM business;"
VITE_BUSINESS_ID=CHANGE_ME_real_business_uuid

# ── Supabase (future) ─────────────────────────────────────────────────────
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Analytics (future) ────────────────────────────────────────────────────
# VITE_GA_ID=G-XXXXXXXXXX
# VITE_FB_PIXEL_ID=XXXXXXXXXX
